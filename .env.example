NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://solar:solar_dev@127.0.0.1:5432/solar_platform_v2
DATABASE_SSL=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:4173
SESSION_TTL_HOURS=12
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=2000
VITE_API_URL=http://127.0.0.1:8787
ALLOWED_ORIGINS=http://127.0.0.1:4173
CLIENT_MIN_VERSION=0.7.1
API_COMPATIBILITY=7.1
# Native release builds set VITE_API_URL to an HTTPS API endpoint; never put DATABASE_URL or SESSION_SECRET in VITE_* variables.
